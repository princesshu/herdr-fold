# The programs herdr-fold uses: install.sh installs the missing ones, uninstall.sh names them
brew "herdr"      # agents and terminals in workspaces (install.sh links its plugins)
brew "starship"   # prompt: folder + git branch
brew "gh"         # GitHub: sign in through the browser, git pushes through it (step 7 of the installer)
brew "bat"        # the sidebar's file previews, in color
brew "git-delta"  # the sidebar's diff previews
brew "ripgrep"    # the sidebar's search, fast in any folder

cask "ghostty"                        # terminal
cask "font-jetbrains-mono-nerd-font"  # font with icons
