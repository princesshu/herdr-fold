# The programs herdr-fold uses: install.sh installs the missing ones of the parts chosen ([tui], or [both] for the
# Herdr app's too), uninstall.sh names them
brew "herdr"      # agents and terminals in workspaces (install.sh links its plugins) [tui]
brew "starship"   # prompt: folder + git branch [tui]
brew "gh"         # GitHub: sign in through the browser, git pushes through it (step 7 of the installer) [both]
brew "bat"        # the sidebar's file previews, in color [tui]
brew "git-delta"  # the sidebar's diff previews [tui]
brew "ripgrep"    # the sidebar's search, fast in any folder [both]

cask "ghostty"                        # terminal [tui]
cask "font-jetbrains-mono-nerd-font"  # font with icons [tui]
