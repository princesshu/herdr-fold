{
  "id": "root",
  "type": "row",
  "theme": "herdr-fold",
  "font": "Menlo",
  "font_size": 13,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    12,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 76,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "divider": {
            "width": 1,
            "color": "border"
          },
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "herdr-fold",
                "props": {
                  "part": "spaces"
                }
              }
            },
            {
              "id": "conversations",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "herdr-fold",
                "props": {
                  "part": "conversations"
                }
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "top",
          "type": "row",
          "size": {
            "px": 42
          },
          "children": [
            {
              "id": "sidebar-trigger",
              "type": "block",
              "size": {
                "px": 40
              },
              "hidden": true,
              "window_drag": true,
              "content": {
                "mod": "herdr-fold",
                "props": {
                  "part": "trigger"
                }
              }
            },
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "weight": 1
              },
              "window_drag": true,
              "content": {
                "mod": "herdr-fold",
                "props": {
                  "part": "tabs"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  }
                }
              }
            },
            {
              "id": "fold-panel",
              "type": "column",
              "size": {
                "px": 368
              },
              "min": 76,
              "max": 900,
              "resizable": false,
              "gap": 8,
              "children": [
                {
                  "id": "fold-dock-head",
                  "type": "block",
                  "size": {
                    "px": 36
                  },
                  "content": {
                    "mod": "herdr-fold",
                    "props": {
                      "part": "dock-head"
                    }
                  }
                },
                {
                  "id": "fold-dock",
                  "type": "column",
                  "gap": 8,
                  "children": [
                    {
                      "id": "fold-project",
                      "type": "column",
                      "size": {
                        "weight": 2
                      },
                      "resizable": false,
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "radius": 10,
                      "children": [
                        {
                          "id": "fold-project-head",
                          "type": "block",
                          "size": {
                            "px": 36
                          },
                          "content": {
                            "mod": "herdr-fold",
                            "props": {
                              "part": "group-head",
                              "group": "project"
                            }
                          }
                        },
                        {
                          "id": "fold-project-body",
                          "type": "stack",
                          "active": "files",
                          "children": [
                            {
                              "id": "files",
                              "type": "block",
                              "content": {
                                "mod": "herdr-fold",
                                "props": {
                                  "part": "files"
                                }
                              }
                            },
                            {
                              "id": "search",
                              "type": "block",
                              "content": {
                                "mod": "herdr-fold",
                                "props": {
                                  "view": "search"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "fold-work",
                      "type": "column",
                      "size": {
                        "weight": 3
                      },
                      "resizable": false,
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "radius": 10,
                      "children": [
                        {
                          "id": "fold-work-head",
                          "type": "block",
                          "size": {
                            "px": 36
                          },
                          "content": {
                            "mod": "herdr-fold",
                            "props": {
                              "part": "group-head",
                              "group": "work"
                            }
                          }
                        },
                        {
                          "id": "fold-work-body",
                          "type": "stack",
                          "active": "changes",
                          "children": [
                            {
                              "id": "changes",
                              "type": "block",
                              "content": {
                                "mod": "herdr-fold",
                                "props": {
                                  "view": "changes"
                                }
                              }
                            },
                            {
                              "id": "issues",
                              "type": "block",
                              "content": {
                                "mod": "herdr-fold",
                                "props": {
                                  "view": "issues"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "fold-terminals",
                      "type": "stack",
                      "size": {
                        "weight": 2
                      },
                      "min": 120,
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "radius": 10,
                      "header": {
                        "content": {
                          "mod": "herdr-fold",
                          "props": {
                            "part": "terminal"
                          }
                        },
                        "height": 0
                      },
                      "active": "fold-terminal-none",
                      "children": [
                        {
                          "id": "fold-terminal-none",
                          "type": "block",
                          "content": {
                            "mod": "herdr-fold",
                            "props": {
                              "part": "none"
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "panel-rail",
                  "type": "block",
                  "hidden": true,
                  "content": {
                    "mod": "herdr-fold",
                    "props": {
                      "part": "rail"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
